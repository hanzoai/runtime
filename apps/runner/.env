ENVIRONMENT=development

API_PORT=3003
API_TOKEN=secret_api_token

RUNTIME_BINARY_URL=https://hanzo.ai/runtime
TERMINAL_BINARY_URL=https://runtime-ai-saas-stage.s3.us-east-1.amazonaws.com/term
RUNTIME_BINARY_PATH=/workspaces/runtime/dist/apps/daemon-amd64
TERMINAL_BINARY_PATH=/workspaces/runtime/.tmp/binaries/terminal
LOG_FILE_PATH=/home/runtime/runner/runner.log

AWS_ENDPOINT_URL=http://minio:9000
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_BUCKET=runtime